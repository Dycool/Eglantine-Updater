<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK version in the TFM is required for toast notifications. -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <AssemblyName>EglantineUpdater</AssemblyName>
    <RootNamespace>EglantineUpdater</RootNamespace>
    <ApplicationIcon>Assets\EglantineUpdater.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Shown by Windows as the toast sender name -->
    <AssemblyTitle>Eglantine Updater</AssemblyTitle>
    <Product>Eglantine Updater</Product>
    <Company>Eglantine Updater</Company>
    <Description>Keeps Eglantine up to date from its GitHub releases.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

</Project>
